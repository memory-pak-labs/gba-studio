  "dialogues": [
    {
      "character": "Narrador",
      "choiceTranslations": {},
      "choices": [],
      "confirmSound": "farol_sfx_dialogo",
      "emote": "",
      "key": "prologo_frame_1",
      "portrait": "",
      "text": "Os faróis da costa se apagam um a um. O último clarão ainda recorta o cais.",
      "textSound": "farol_sfx_texto",
      "translations": {
        "pt-BR": "Os faróis da costa se apagam um a um. O último clarão ainda recorta o cais.",
        "es": "Os faróis da costa se apagam um a um. O último clarão ainda recorta o cais."
      },
      "translationStatus": {
        "pt-BR": "approved",
        "es": "approved"
      }
    },
    {
      "character": "Narrador",
      "choiceTranslations": {},
      "choices": [],
      "confirmSound": "farol_sfx_dialogo",
      "emote": "",
      "key": "prologo_frame_2",
      "portrait": "",
      "text": "A rota aérea desaparece sobre a tempestade. Nara encontra a aeronave antes que a noite feche o porto.",
      "textSound": "farol_sfx_texto",
      "translations": {
        "pt-BR": "A rota aérea desaparece sobre a tempestade. Nara encontra a aeronave antes que a noite feche o porto.",
        "es": "A rota aérea desaparece sobre a tempestade. Nara encontra a aeronave antes que a noite feche o porto."
      },
      "translationStatus": {
        "pt-BR": "approved",
        "es": "approved"
      }
    },
    {
      "character": "Nara",
      "choiceTranslations": {},
      "choices": [],
      "confirmSound": "farol_sfx_dialogo",
      "emote": "",
      "key": "prologo_frame_3",
      "portrait": "nara-portrait.png",
      "portraitSlot": "Esquerda",
      "text": "Se o farol não pode guiar o caminho, eu vou acendê-lo de novo.",
      "textSound": "farol_sfx_texto",
      "translations": {
        "pt-BR": "Se o farol não pode guiar o caminho, eu vou acendê-lo de novo.",
        "es": "Se o farol não pode guiar o caminho, eu vou acendê-lo de novo."
      },
      "translationStatus": {
        "pt-BR": "approved",
        "es": "approved"
      }
    },
    {
      "character": "Nara",
      "choiceTranslations": {},
      "choices": [],
      "confirmSound": "farol_sfx_dialogo",
      "emote": "",
      "key": "porto_objetivo",
      "portrait": "",
      "text": "A estrutura da aeronave está no cais leste.",
      "textSound": "farol_sfx_texto",
      "translations": {
        "pt-BR": "A estrutura da aeronave está no cais leste.",
        "es": "A estrutura da aeronave está no cais leste."
      },
      "translationStatus": {
        "pt-BR": "approved",
        "es": "approved"
      }
    },
    {
      "character": "Nara",
      "choiceTranslations": {},
      "choices": [],
      "confirmSound": "farol_sfx_dialogo",
      "emote": "",
      "key": "farol_interior_objetivo",
      "portrait": "",
      "text": "A lente ainda responde, mas o mecanismo precisa de manutenção. Vou falar com o guardião.",
      "textSound": "farol_sfx_texto",
      "translations": {
        "pt-BR": "A lente ainda responde, mas o mecanismo precisa de manutenção. Vou falar com o guardião.",
        "es": "A lente ainda responde, mas o mecanismo precisa de manutenção. Vou falar com o guardião."
      },
      "translationStatus": {
        "pt-BR": "approved",
        "es": "approved"
      }
    },
    {
      "character": "Guardião do farol",
      "choiceTranslations": {},
      "choices": [],
      "confirmSound": "farol_sfx_dialogo",
      "emote": "",
      "key": "farol_guardiao",
      "portrait": "",
      "text": "A maré trouxe sal para os encaixes. Examine a lente e depois volte ao cais; o sinal precisa de uma rota livre.",
      "textSound": "farol_sfx_texto",
      "translations": {
        "pt-BR": "A maré trouxe sal para os encaixes. Examine a lente e depois volte ao cais; o sinal precisa de uma rota livre.",
        "es": "A maré trouxe sal para os encaixes. Examine a lente e depois volte ao cais; o sinal precisa de uma rota livre."
      },
      "translationStatus": {
        "pt-BR": "approved",
        "es": "approved"
      }
    },
    {
