    },
    {
      "key": "showcase_epilogue_exploration",
      "character": "",
      "portrait": "",
      "emote": "",
      "text": "With the beacons lit, the compass points beyond the storm. Your exploration pact opens a new journey.",
      "translations": {
        "pt-BR": "Com os faróis acesos, a bússola aponta além da tempestade. O pacto de exploração que você escolheu abre uma nova jornada.",
        "es": "Con los faros encendidos, la brújula señala más allá de la tormenta. Tu pacto de exploración abre otra aventura."
      },
      "choices": [],
      "choiceTranslations": {
        "pt-BR": [],
