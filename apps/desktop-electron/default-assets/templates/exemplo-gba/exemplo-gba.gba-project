      "emote": "",
      "choices": [],
      "translations": {
        "pt-BR": "Direcional: mover e selecionar. A: confirmar ou interagir. B: voltar. Start: pausa. Dungeon: R pausa, Start mapa, Select mochila. Na corrida: A acelera, B freia; direcional vira.",
        "es": "Cruceta: mover y elegir. A: confirmar o interactuar. B: volver. Start: pausa. Mazmorra: R pausa, Start mapa, Select mochila. Carrera: A acelera, B frena; cruceta gira."
