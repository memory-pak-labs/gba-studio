    "supportBriefing": {
      "title": "Armazém das Marés",
      "objective": "Examinar a carta náutica, o baú e a saída do armazém.",
      "controls": "Mova o cursor com o direcional; A examina o hotspot; B cancela.",
      "success": "Reconhecer a rota que liga o armazém ao observatório.",
      "failureRecovery": "Cada hotspot pode ser reaberto sem perder o estado da cena."
    },
    "campaign": {
      "chapter": 5,
      "title": "Capítulo 2 · Armazém das Marés",
      "objective": "Examinar a carta, o baú e a saída que leva ao observatório.",
      "nextScene": "observatorio_do_farol",
      "completionVariable": "routeFlags.warehouseInspected",
      "completedValue": 1,
      "controls": "Direcional move o cursor; A examina o hotspot; B cancela.",
      "success": "Reconhecer a rota que liga o armazém ao observatório.",
      "failureRecovery": "Os hotspots permanecem disponíveis depois de cada diálogo.",
      "tutorialDialogue": ""
    },
    "authoringNotes": "Objetivo: Examinar a carta, o baú e a saída que leva ao observatório. O player é o cursor. Cada gatilho é um hotspot: selecione-o e abra Ao interagir para editar exame, coleta ou saída. A imagem frontal não é uma grade de colisões top-down. Controles: Direcional move o cursor; A examina o hotspot; B cancela."
  },
