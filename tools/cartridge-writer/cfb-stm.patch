@@ -10,6 +10,24 @@ use std::time::{Duration, Instant};
 
 use serialport::{ClearBuffer, DataBits, FlowControl, Parity, SerialPort, StopBits};
 
+// STM firmware has no 0xa0 command and is permanently powered at 3.3 V.
+// Keep the normal upstream power-control path unless explicitly selected.
+fn power_packet(code: u8, supported: bool) -> Option<[u8; 2]> {
+    supported.then_some([0xa0, code])
+}
+
+#[cfg(test)]
+mod stm_compatibility_tests {
+    use super::*;
+
+    #[test]
+    fn stm_firmware_never_receives_unsupported_power_packets() {
+        assert_eq!(power_packet(1, false), None);
+        assert_eq!(power_packet(0, false), None);
+        assert_eq!(power_packet(1, true), Some([0xa0, 1]));
+    }
+}
+
 /// 本烧录器的 USB 标识（STMicroelectronics CDC 虚拟串口）。
